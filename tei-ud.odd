<?xml version="1.0" encoding="utf-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0">
  <teiHeader>
    <fileDesc>
      <titleStmt>
        <title>Minimal TEI for linguistic annotation with Universal Dependencies features as word attributes</title>
        <author>thjbdvlt</author>
      </titleStmt>
      <publicationStmt>
        <p>freely available</p>
      </publicationStmt>
      <sourceDesc>
        <p>Written from scratch using examples from TEI guidelines.</p>
      </sourceDesc>
    </fileDesc>
  </teiHeader>
  <text>
    <body>
      <schemaSpec ident="tei-ud" start="TEI">
        <!-- header -->
        <moduleRef key="core" include="author biblStruct date foreign head imprint name measure monogr p pubPlace publisher q resp respStmt title"/>
        <moduleRef key="header" include="availability encodingDesc fileDesc licence publicationStmt sourceDesc teiHeader titleStmt"/>
        <moduleRef key="textstructure" include="TEI text body div"/>
        <moduleRef key="namesdates" include="persName orgName"/>
        <!-- element for teiHeader documentation -->
        <moduleRef key="tagdocs" include="ident"/>
        <!-- text -->
        <moduleRef key="tei"/>
        <!-- words, punctuation, sentence, phrase -->
        <moduleRef key="analysis" include="w pc s"/>
        <!-- word attributes: @pos, @lemma, @msd -->
        <classRef key="att.linguistic"/>
        <!-- UD features as word attributes: @ud:Tense, @ud:Mood -->
        <elementSpec ident="TEI" mode="change">
          <attList>
            <attDef mode="add" ident="xmlns:ud">
              <desc>Namespace declaration for Universal features.</desc>
            </attDef>
          </attList>
        </elementSpec>
        <elementSpec ident="w" mode="change">
          <attList>
            <attDef mode="add" ident="ud:Definite" ns="https://universaldependencies.org/u/feat">
              <desc>Morphological feature <ident>Definite</ident> from Universal features.</desc>
              <valList>
                <valItem ident="Def"/>
                <valItem ident="Ind"/>
              </valList>
            </attDef>
            <attDef mode="add" ident="ud:Number" ns="https://universaldependencies.org/u/feat">
              <desc>Morphological feature <ident>Number</ident> from Universal features.</desc>
              <valList>
                <valItem ident="Plur"/>
                <valItem ident="Sing"/>
              </valList>
            </attDef>
            <attDef mode="add" ident="ud:PronType" ns="https://universaldependencies.org/u/feat">
              <desc>Morphological feature <ident>PronType</ident> from Universal features.</desc>
              <valList>
                <valItem ident="Art"/>
                <valItem ident="Dem"/>
                <valItem ident="Ind"/>
                <valItem ident="Int"/>
                <valItem ident="Neg"/>
                <valItem ident="Prs"/>
                <valItem ident="Rel"/>
              </valList>
            </attDef>
            <attDef mode="add" ident="ud:Mood" ns="https://universaldependencies.org/u/feat">
              <desc>Morphological feature <ident>Mood</ident> from Universal features.</desc>
              <valList>
                <valItem ident="Cnd"/>
                <valItem ident="Imp"/>
                <valItem ident="Ind"/>
                <valItem ident="Sub"/>
              </valList>
            </attDef>
            <attDef mode="add" ident="ud:Person" ns="https://universaldependencies.org/u/feat">
              <desc>Morphological feature <ident>Person</ident> from Universal features.</desc>
              <valList>
                <valItem ident="1"/>
                <valItem ident="2"/>
                <valItem ident="3"/>
              </valList>
            </attDef>
            <attDef mode="add" ident="ud:Tense" ns="https://universaldependencies.org/u/feat">
              <desc>Morphological feature <ident>Tense</ident> from Universal features.</desc>
              <valList>
                <valItem ident="Fut"/>
                <valItem ident="Imp"/>
                <valItem ident="Past"/>
                <valItem ident="Pres"/>
              </valList>
            </attDef>
            <attDef mode="add" ident="ud:Number_psor" ns="https://universaldependencies.org/u/feat">
              <desc>Morphological feature <ident>Number[psor]</ident> from Universal features.</desc>
              <valList>
                <valItem ident="Plur"/>
                <valItem ident="Sing"/>
              </valList>
            </attDef>
            <attDef mode="add" ident="ud:Poss" ns="https://universaldependencies.org/u/feat">
              <desc>Morphological feature <ident>Poss</ident> from Universal features.</desc>
              <valList>
                <valItem ident="Yes"/>
              </valList>
            </attDef>
            <attDef mode="add" ident="ud:VerbForm" ns="https://universaldependencies.org/u/feat">
              <desc>Morphological feature <ident>VerbForm</ident> from Universal features.</desc>
              <valList>
                <valItem ident="Inf"/>
                <valItem ident="Part"/>
              </valList>
            </attDef>
            <attDef mode="add" ident="ud:Voice" ns="https://universaldependencies.org/u/feat">
              <desc>Morphological feature <ident>Voice</ident> from Universal features.</desc>
              <valList>
                <valItem ident="Pass"/>
              </valList>
            </attDef>
            <attDef mode="add" ident="ud:NumType" ns="https://universaldependencies.org/u/feat">
              <desc>Morphological feature <ident>NumType</ident> from Universal features.</desc>
              <valList>
                <valItem ident="Card"/>
                <valItem ident="Ord"/>
              </valList>
            </attDef>
            <attDef mode="add" ident="ud:Polarity" ns="https://universaldependencies.org/u/feat">
              <desc>Morphological feature <ident>Polarity</ident> from Universal features.</desc>
              <valList>
                <valItem ident="Neg"/>
              </valList>
            </attDef>
            <attDef mode="add" ident="ud:Reflex" ns="https://universaldependencies.org/u/feat">
              <desc>Morphological feature <ident>Reflex</ident> from Universal features.</desc>
              <valList>
                <valItem ident="Yes"/>
              </valList>
            </attDef>
          </attList>
        </elementSpec>
      </schemaSpec>
    </body>
  </text>
</TEI>
