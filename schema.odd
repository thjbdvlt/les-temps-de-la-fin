<?xml version="1.0" encoding="utf-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0">
  <teiHeader>
    <fileDesc>
      <titleStmt>
        <title>Minimal TEI for linguistic annotation with Universal Dependencies features as word attributes</title>
        <author>thjbdvlt</author>
      </titleStmt>
      <publicationStmt>
        <p>freely available</p>
      </publicationStmt>
      <sourceDesc>
        <p>Written from scratch using examples from TEI guidelines.</p>
      </sourceDesc>
    </fileDesc>
  </teiHeader>
  <text>
    <body>
      <schemaSpec ident="tei-ud" start="TEI">
        <!-- header -->
        <moduleRef key="header" include="availability encodingDesc fileDesc licence publicationStmt sourceDesc teiHeader titleStmt"/>
        <moduleRef key="core" include="author biblStruct date head imprint monogr p pubPlace publisher resp respStmt title"/>
        <moduleRef key="textstructure" include="TEI text body div"/>
        <moduleRef key="namesdates" include="persName orgName"/>
        <!-- text -->
        <moduleRef key="tei"/>
        <!-- words, punctuation, sentence, phrase -->
        <moduleRef key="analysis" include="w pc measure date s"/>
        <!-- word attributes: @pos, @lemma, @msd -->
        <classRef key="att.linguistic"/>
        <!-- UD features as word attributes: @ud:Tense, @ud:Mood -->
        <elementSpec ident="w" mode="change">
          <attList>
            <attDef mode="add" ident="Definite" ns="https://universaldependencies.org/u/feat">
              <desc>Morphological feature 'Definite' from Universal features.</desc>
              <valList>
                <valItem ident="Def"/>
                <valItem ident="Ind"/>
              </valList>
            </attDef>
            <attDef mode="add" ident="Number" ns="https://universaldependencies.org/u/feat">
              <desc>Morphological feature 'Number' from Universal features.</desc>
              <valList>
                <valItem ident="Plur"/>
                <valItem ident="Sing"/>
              </valList>
            </attDef>
            <attDef mode="add" ident="PronType" ns="https://universaldependencies.org/u/feat">
              <desc>Morphological feature 'PronType' from Universal features.</desc>
              <valList>
                <valItem ident="Art"/>
                <valItem ident="Dem"/>
                <valItem ident="Ind"/>
                <valItem ident="Int"/>
                <valItem ident="Neg"/>
                <valItem ident="Prs"/>
                <valItem ident="Rel"/>
              </valList>
            </attDef>
            <attDef mode="add" ident="Mood" ns="https://universaldependencies.org/u/feat">
              <desc>Morphological feature 'Mood' from Universal features.</desc>
              <valList>
                <valItem ident="Cnd"/>
                <valItem ident="Imp"/>
                <valItem ident="Ind"/>
                <valItem ident="Sub"/>
              </valList>
            </attDef>
            <attDef mode="add" ident="Person" ns="https://universaldependencies.org/u/feat">
              <desc>Morphological feature 'Person' from Universal features.</desc>
              <valList>
                <valItem ident="1"/>
                <valItem ident="2"/>
                <valItem ident="3"/>
              </valList>
            </attDef>
            <attDef mode="add" ident="Tense" ns="https://universaldependencies.org/u/feat">
              <desc>Morphological feature 'Tense' from Universal features.</desc>
              <valList>
                <valItem ident="Fut"/>
                <valItem ident="Imp"/>
                <valItem ident="Past"/>
                <valItem ident="Pres"/>
              </valList>
            </attDef>
            <attDef mode="add" ident="Number_psor" ns="https://universaldependencies.org/u/feat">
              <desc>Morphological feature 'Number[psor]' from Universal features.</desc>
              <valList>
                <valItem ident="Plur"/>
                <valItem ident="Sing"/>
              </valList>
            </attDef>
            <attDef mode="add" ident="Poss" ns="https://universaldependencies.org/u/feat">
              <desc>Morphological feature 'Poss' from Universal features.</desc>
              <valList>
                <valItem ident="Yes"/>
              </valList>
            </attDef>
            <attDef mode="add" ident="VerbForm" ns="https://universaldependencies.org/u/feat">
              <desc>Morphological feature 'VerbForm' from Universal features.</desc>
              <valList>
                <valItem ident="Inf"/>
                <valItem ident="Part"/>
              </valList>
            </attDef>
            <attDef mode="add" ident="Voice" ns="https://universaldependencies.org/u/feat">
              <desc>Morphological feature 'Voice' from Universal features.</desc>
              <valList>
                <valItem ident="Pass"/>
              </valList>
            </attDef>
            <attDef mode="add" ident="NumType" ns="https://universaldependencies.org/u/feat">
              <desc>Morphological feature 'NumType' from Universal features.</desc>
              <valList>
                <valItem ident="Card"/>
                <valItem ident="Ord"/>
              </valList>
            </attDef>
            <attDef mode="add" ident="Polarity" ns="https://universaldependencies.org/u/feat">
              <desc>Morphological feature 'Polarity' from Universal features.</desc>
              <valList>
                <valItem ident="Neg"/>
              </valList>
            </attDef>
            <attDef mode="add" ident="Reflex" ns="https://universaldependencies.org/u/feat">
              <desc>Morphological feature 'Reflex' from Universal features.</desc>
              <valList>
                <valItem ident="Yes"/>
              </valList>
            </attDef>
          </attList>
        </elementSpec>
      </schemaSpec>
    </body>
  </text>
</TEI>
